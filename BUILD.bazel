# Overlay BUILD for the mem0 nested repo (third-party upstream mem0ai/mem0 —
# ships no Bazel files). Only the FastAPI app under server/ is consumed here;
# the rest of the upstream tree (the mem0ai SDK, docs, examples, embedchain)
# comes along with the checkout but is not built.
#
# The image itself is assembled in //tools/mcp/mem0/server — this file only
# exposes the upstream sources as handles for those rules.

filegroup(
    name = "server_srcs",
    srcs = glob(
        ["server/**/*.py"],
        allow_empty = True,
    ),
    visibility = ["@ideaprojects//tools/mcp/mem0:__subpackages__"],
)

# Alembic migrations ship in the image and run as the `db-migrate` initContainer
# (`alembic upgrade head`). Without alembic.ini + versions/ present at /app the
# server 500s on every request with `relation "request_logs" does not exist`.
filegroup(
    name = "server_migrations",
    srcs = glob(
        [
            "server/alembic.ini",
            "server/alembic/**",
        ],
        allow_empty = True,
    ),
    visibility = ["@ideaprojects//tools/mcp/mem0:__subpackages__"],
)

# NOTE: there is deliberately no `exports_files(["server/requirements.txt"])` here.
# server/ is its own Bazel package, so a root-package export of a file inside it is
# inert — the label never resolves and nothing can depend on it. One lived here until
# 2026-07-30 and was actively misleading: it looked exactly like the export
# //tools/mcp/mem0/server:requirements_in_sync_test needs, which is why that test
# appeared to be already wired when it was not. The live export is in
# server/BUILD.bazel.
