"""Bazel view of upstream mem0's FastAPI app (server/).

Overlay-only: upstream mem0ai/mem0 ships no BUILD files, and its own packaging is
a Dockerfile that `pip install -r requirements.txt` then `COPY . .` into /app.
This library reproduces that import surface for rules_py.

`imports = ["."]` is the load-bearing line. Upstream sets WORKDIR /app and runs
`uvicorn main:app`, so every module here is a TOP-LEVEL import (`main`, `db`,
`auth`, `models`, `routers.*`) — not `server.main`. Dropping this makes the app
import cleanly on a developer's machine and fail only inside the container.
"""

load("@bazel_lib//lib:transitions.bzl", "platform_transition_test")
load("@aspect_rules_py//py:defs.bzl", "py_library", "py_test")
load("@pypi_mem0//:defs.bzl", "group_deps_for")

package(default_visibility = ["@ideaprojects//tools/mcp/mem0:__subpackages__"])

# requirements.txt is the SOURCE this whole dependency set is transcribed from:
# @ideaprojects//tools/mcp/mem0/server:pyproject.toml is a hand copy of it, because
# rules_py's uv resolver needs a pyproject + uv.lock pair and upstream ships neither
# (its Dockerfile just pip-installs this file). Exported so a test over there can
# compare the two and fail when the pin here moves out from under the copy.
#
# It must be exported HERE, in server/'s own package. The repo-root BUILD carries
# exports_files(["server/requirements.txt"]), which is dead — this directory is its own
# package, so the root cannot export a file inside it. That dead export looks exactly
# like the one you need; do not rely on it.
exports_files(["requirements.txt"])

py_library(
    name = "server",
    srcs = glob(
        ["**/*.py"],
        allow_empty = False,
        exclude = [
            # Upstream's operator UI — a Next.js 15 app (dashboard/package.json is
            # `mem0-dashboard`, next 15.5.18 + react 19), NOT the Streamlit UI an
            # earlier revision of this comment claimed. It holds no Python at all, so
            # this glob would skip it regardless; the exclusion is here to say so
            # deliberately rather than by accident. It is not deployed — see
            # @ideaprojects//tools/mcp/mem0:CLAUDE.md for the scope decision.
            "dashboard/**",
            # Tests are their own target below. Excluded here so they stay out of
            # the py_binary closure and therefore out of the shipped image.
            "tests/**",
        ],
    ),
    data = glob(
        [
            "alembic.ini",
            "alembic/**",
        ],
        allow_empty = False,
    ),
    imports = ["."],
    # The whole `mem0-server` dependency group, i.e. every package uv.lock resolved for it —
    # NOT a hand-written label list. This was a hand-written list of 16
    # `@pypi_mem0//<pkg>` labels, and that is what broke the Bedrock embedder: on 2026-08-05
    # `MEM0_EMBEDDER_PROVIDER=aws_bedrock` CrashLoopBackOff'd on `import boto3`, with boto3
    # DECLARED in @ideaprojects//tools/mcp/mem0/server:pyproject.toml, resolved into uv.lock,
    # passing :requirements_in_sync_test — and simply never installed, because no target
    # depended on it. It presents exactly like a stale lock or a stale module extension and is
    # neither, which is why it cost a day.
    #
    # Being in the lock is NECESSARY BUT NOT SUFFICIENT. `uv.declare_hub` only makes the
    # `@pypi_mem0//<pkg>` labels available; rules_py installs a wheel into the venv when
    # something in the closure DEPENDS on it. A fourth copy of the dependency set living here
    # meant `pip install -r requirements.txt` and this image could disagree, silently, in the
    # direction of a missing module at runtime.
    #
    # So the set is now stated ONCE. pyproject.toml is the source of truth,
    # :requirements_in_sync_test pins it to the fork's requirements.txt, and the venv is
    # whatever that resolves to — the same semantics as upstream's `pip install -r`. Adding a
    # dependency is now: edit pyproject.toml, `aspect run //tools/mcp/mem0/server:lock`, done.
    #
    # The cost, accepted deliberately: no per-target dependency strictness. Any module under
    # server/ can import any locked package without declaring it. That is the right trade for
    # a dependency set that exists to describe ONE image and is already governed by a test;
    # the strictness was buying nothing here and cost an outage.
    #
    # `group_deps_for("mem0-server")`, NOT the `group_deps()` that follows the consuming
    # target's group. Both read the same table; `group_deps()` returns a `select()` over
    # `@pypi_mem0//dep_group:*`, and a py_library cannot set `dep_group` — that attribute only
    # exists on py_binary/py_test/py_venv, where it is a transition. So under `group_deps()`
    # this target stops analyzing on its own (`configurable attribute "deps" ... doesn't match
    # this configuration`) and takes any wildcard containing it down with it. There is exactly
    # one group here, so following the consumer's choice buys nothing anyway.
    #
    # The returned labels are still hub ALIASES resolved under the active `dep_group`, so
    # consumers must set `dep_group = "mem0-server"` regardless — the py_binary in
    # @ideaprojects//tools/mcp/mem0/server and both py_tests below do.
    deps = group_deps_for("mem0-server"),
)

# stdlib `unittest`, NOT pytest. Adding pytest meant a `[dependency-groups]`
# block in tools/mcp/mem0/server/pyproject.toml, and rules_py's `uv.project`
# then emitted a hub containing ONLY that group — the `mem0_server` dep group
# vanished and every `@pypi_mem0//<pkg>` label above failed at analysis. unittest
# needs nothing in the lock, so the shipped image's dep graph is untouched.
#
# `dep_group` for the same reason as the py_binary in
# @ideaprojects//tools/mcp/mem0/server: the uv hub gates every wheel on
# `//dep_group:mem0-server`, and without it they resolve to
# `@platforms//:incompatible`.
py_test(
    name = "auth0_test_impl",
    size = "small",
    srcs = ["tests/test_auth0.py"],
    dep_group = "mem0-server",
    main = "tests/test_auth0.py",
    tags = ["manual"],
    # `imports = ["."]` on :server makes the app's modules top-level (`auth0`,
    # `auth`, ...), so the test imports them exactly as the app does.
    deps = [":server"],
)

# The @pypi_mem0 wheels are resolved for linux/glibc (that is what the image
# ships), and rules_py gates its interpreter and wheel toolchains on
# `platform_libc`, which the repo-default linux_amd64 platform does not set. So
# the test has to run under the same platform the image is built for — hence the
# transition rather than a bare py_test. Runs remotely; it will not run on a
# macOS exec platform.
platform_transition_test(
    name = "auth0_test",
    binary = ":auth0_test_impl",
    target_platform = "@ideaprojects//tools/mcp/mem0/server:linux_x86_64",
)

# Doubles as the boto3 canary. Every other check on that dependency (pyproject, uv.lock, the
# requirements-in-sync test) looks at a DECLARATION; this one imports it, so it goes red on
# exactly the failure that put the pod in CrashLoopBackOff — the wheel resolved but never
# installed because no target depended on it.
py_test(
    name = "bedrock_embedder_test_impl",
    size = "small",
    srcs = ["tests/test_bedrock_embedder.py"],
    dep_group = "mem0-server",
    main = "tests/test_bedrock_embedder.py",
    tags = ["manual"],
    deps = [":server"],
)

platform_transition_test(
    name = "bedrock_embedder_test",
    binary = ":bedrock_embedder_test_impl",
    target_platform = "@ideaprojects//tools/mcp/mem0/server:linux_x86_64",
)
